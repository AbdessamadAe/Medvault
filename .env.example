# Copy this file to .env.local for local development.
# Never commit the real .env.local — it is already in .gitignore.

# --- Supabase project (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — used only by the backup script
# and other trusted server-side maintenance tasks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection (Supabase Settings > Database) ---
# Pooled connection (port 6543, pgbouncer) — used by the running app.
DATABASE_URL=
# Direct connection (port 5432) — used only by drizzle-kit migrations.
MIGRATION_DATABASE_URL=

# --- Storage ---
# Name of the private Supabase Storage bucket that holds medical file uploads.
SUPABASE_STORAGE_BUCKET=medical-files

# --- Backup destination (Backblaze B2, S3-compatible API) ---
# Used only by scripts/backup.ts and the GitHub Actions backup workflow.
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
